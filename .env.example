# ASTRA BOT — Environment Variables
# ==========================================
# СКОПИРУЙТЕ этот файл в .env и заполните значения!
# Никогда не коммитьте реальный .env в репозиторий!
# ==========================================

# ============================================================
# ПЕРЕМЕННЫЕ СИСТЕМЫ
# ============================================================

# Рабочая директория
APP_HOME=/app

# Режим работы: development | paper | production
ENVIRONMENT=development

# ============================================================
# БАЗА ДАННЫХ (PostgreSQL)
# ============================================================

# Хост базы данных (localhost для локальной, IP VPS для production)
DB_HOST=localhost

# Порт PostgreSQL
DB_PORT=5432

# Имя базы данных
DB_NAME=astra_bot

# Пользователь базы данных
DB_USER=astra

# Пароль базы данных (ИЗМЕНИТЕ НА СЛУЧАЙНЫЙ!)
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE

# ============================================================
# REDIS
# ============================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# TELEGRAM
# ============================================================

# Токен Telegram бота (от @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Ваш Telegram User ID (получите через @userinfobot)
TELEGRAM_USER_ID=YOUR_TELEGRAM_USER_ID_HERE

# Telegram ID администратора (может совпадать с USER_ID)
TELEGRAM_ADMIN_ID=YOUR_TELEGRAM_ADMIN_ID_HERE

# ============================================================
# OKX API
# ============================================================

# API ключ OKX (БЕЗ ПРАВA НА ВЫВОД!)
OKX_API_KEY=YOUR_OKX_API_KEY_HERE

# API секрет OKX
OKX_API_SECRET=YOUR_OKX_API_SECRET_HERE

# Парольная фраза OKX (passphrase)
OKX_PASSPHRASE=YOUR_OKX_PASSPHRASE_HERE

# ============================================================
# BYBIT API (опционально)
# ============================================================

BYBIT_API_KEY=
BYBIT_API_SECRET=

# ============================================================
# БЕЗОПАСНОСТЬ
# ============================================================

# IP адрес VPS (для whitelist)
VPS_IP_ADDRESS=YOUR_VPS_IP_HERE

# Пароль для админ-панели Grafana
GRAFANA_ADMIN_USER=admin

# Пароль для Grafana (ИЗМЕНИТЕ!)
GRAFANA_ADMIN_PASSWORD=YOUR_GRAFANA_PASSWORD_HERE

# ============================================================
# ПРОЧИЕ НАСТРОЙКИ
# ============================================================

# Режим тестирования (paper trading)
PAPER_TRADING=true

# Разрешить реальную торговлю
TRADING_ENABLED=false

# Часовой пояс
TZ=Europe/Moscow

# ============================================================
# ВАЖНЫЕ ПРИМЕЧАНИЯ
# ============================================================
# 1. OKX API ключи ОБЯЗАНЫ иметь только права:
#    - Read: YES
#    - Trade: YES  
#    - Withdraw: NO (ОБЯЗАТЕЛЬНО!)
#
# 2. Создайте отдельного пользователя Telegram через @userinfobot
#    для получения User ID
#
# 3. Сгенерируйте надёжные пароли для базы данных и Grafana
#
# 4. В production установите PAPER_TRADING=false только после
#    успешного тестирования!
# ============================================================
