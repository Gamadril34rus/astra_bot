# ASTRA BOT — Environment Variables
# ==========================================
# СКОПИРУЙТЕ этот файл в .env и заполните значения!
# На Render: добавьте переменные через Dashboard (Environment)
# ==========================================

# Режим работы
ENVIRONMENT=paper
PAPER_TRADING=true

# БАЗА ДАННЫХ (PostgreSQL)
# На Render: DATABASE_URL автоматически из render.yaml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astra_bot
DB_USER=astra
DB_PASSWORD=

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# OKX API
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# RENDER (дополнительно)
RENDER_WEB=true
PORT=8000
LOG_LEVEL=INFO
