# ASTRA BOT — Environment Variables для Paper Trading
# ==========================================
# На Render: добавлять в Dashboard → Environment (не коммитить .env!)
# Скопируйте файл:  cp .env.example .env  и подставьте свои значения.
# ==========================================

# Режим работы
ENVIRONMENT=paper
PAPER_TRADING=true

# БАЗА ДАННЫХ — на Render автоматически из render.yaml
# Для локальной разработки:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astra_bot
DB_USER=astra
DB_PASSWORD=change-me-local

# TELEGRAM (для отчётов)
# Создать бота: @BotFather → /newbot
# Получить ID: @userinfobot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_USER_ID=your-telegram-user-id
TELEGRAM_ADMIN_ID=your-telegram-admin-id

# OKX API (для paper trading API ключи не нужны!)
# Но если позже решите перейти на реальные — они необходимы.
# Ключи ОБЯЗАНЫ быть без прав на вывод средств.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# RENDER
RENDER_WEB=true
PORT=8000
LOG_LEVEL=INFO
LOG_DIR=/tmp/logs

# Полная строка подключения к Postgres (имеет приоритет над DB_*).
# DATABASE_URL=postgresql://astra:password@localhost:5432/astra_bot
