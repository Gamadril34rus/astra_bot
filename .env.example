# ASTRA BOT — Environment Variables для Paper Trading
# ==========================================
# На Render: добавлять в Dashboard → Environment (не коммитить .env!)
# ==========================================

# Режим работы
ENVIRONMENT=paper
PAPER_TRADING=true

# БАЗА ДАННЫХ — на Render автоматически из render.yaml
# Для локальной разработки:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astra_bot
DB_USER=astra
DB_PASSWORD=

# TELEGRAM (для отчётов)
# Создать бота: @BotFather → /newbot
# Получить ID: @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNoPQRStuVwXyz
TELEGRAM_USER_ID=123456789

# OKX API (для paper trading API ключи не нужны!)
# Но если позже решите перейти на реальные —こちらが必要です
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# RENDER
RENDER_WEB=true
PORT=8000
LOG_LEVEL=INFO
