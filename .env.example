# ASTRA BOT — Continuous Demo Trading
ENVIRONMENT=paper
PAPER_TRADING=true

# BingX USDT-M Perps API (активная биржа; ретир OKX → BingX, только перпы).
# Ключи ОПЦИОНАЛЬНЫ для paper-контура: рыночные данные BingX публичны,
# ключи нужны только для отображения реального баланса фьючерсного счёта
# (withdraw permission must be disabled). Passphrase не нужен.
BINGX_API_KEY=
BINGX_API_SECRET=

# OKX — legacy-ключи после ретира на BingX (оставлены для отката).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=1

# Telegram 09:00 MSK report
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_USER_ID=

# News sources are FREE and require no API key:
#   - GDELT DOC 2.0 (primary, current + ~3 months historical)
#   - Free Crypto News API / cryptocurrency.cv (supplementary, safe fallback)
# No NEWS_API_KEY / paid news key is needed anymore.
# Set to "0"/"false" to disable the supplementary Free Crypto News source and
# use only GDELT.
FREE_CRYPTO_NEWS_ENABLED=1

# Runtime
LOG_LEVEL=INFO
LOG_DIR=/opt/astra_bot/logs
ASTRA_CONFIG=config/settings.yaml

# Database is optional for the standalone demo worker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astra_bot
DB_USER=astra
DB_PASSWORD=change-me-local

# HTTP API key for /tick /train /status /metrics (required when ENVIRONMENT=production).
# Paper/dev without a key remains open. Never commit a real key.
ASTRA_API_KEY=
LOG_FORMAT=text

# ============================================================================
# ZEUS LIVE / VST / MAINNET — ПРИМЕРЫ, НЕ РАБОЧИЕ ЗНАЧЕНИЯ.
# Все строки ниже закомментированы намеренно: по умолчанию контур выключен.
# Раскомментирование — осознанное действие владельца. Реальные значения
# задаются только в локальном .env или в GitHub secrets, в git не попадают.
# Чек-лист до реальных денег: docs/REAL_READINESS.md
# ============================================================================
#
# ZEUS_LIVE — включает live-клок (scripts/zeus_live_clock.py). Без "1" тик
#   завершается с ABORT. Требует ENVIRONMENT=live. Сейчас тик только наблюдает:
#   сигнал→вход не подключён.
#   ⚠ Не ставить в 1 без отдельного PR и слова владельца.
# ZEUS_LIVE=1
#
# ZEUS_VST — демо-сервер BingX VST. По умолчанию в коде = 1 (безопасный режим).
#   Безопасное значение для тестов: 1.
# ZEUS_VST=1
#
# ZEUS_MAINNET — реальные деньги на основной площадке BingX.
#   ⚠⚠ ОПАСНО: реальные деньги. Требует явного ZEUS_VST=0 — при ZEUS_VST=1
#   (или без него, по умолчанию 1) клок делает ABORT, а клиент остаётся на VST.
#   Не включать без: гейтов (а)–(е) из docs/REAL_READINESS.md, отдельного PR и
#   явного слова владельца.
# ZEUS_MAINNET=1
# ZEUS_VST=0
