# ASTRA BOT — Continuous Demo Trading
ENVIRONMENT=paper
PAPER_TRADING=true
OKX_DEMO=1

# OKX Demo Trading API. Withdraw permission must be disabled.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Telegram 09:00 MSK report
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_USER_ID=

# Optional: historical news for the five-year pretrain.
# NewsAPI supports up to five years on paid plans; free developer access is
# intended for development/testing only.
NEWS_API_KEY=

# Runtime
LOG_LEVEL=INFO
LOG_DIR=/opt/astra_bot/logs
ASTRA_CONFIG=config/settings.yaml

# Database is optional for the standalone demo worker.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=astra_bot
DB_USER=astra
DB_PASSWORD=change-me-local
