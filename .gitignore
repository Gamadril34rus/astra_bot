# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs - allow errors.log for diagnostics (Block 1.5)
logs/
!logs/.gitkeep
!logs/errors.log
*.log
*.log.*
!logs/errors.log

# Data — Block 2.1: Git-based persistence, must be committed!
# data/ folder is intentionally NOT ignored, only tmp files ignored
data/*.tmp
data/*.tmp.*
backups/
# Runtime state in models/ — historically ignored but force-added via git add -f
models/*.jsonl
models/*.json
models/*.csv
models/*.pkl
models/*.bin
# Allow: samples (schemas), archive dir, .gitkeep
!models/samples/
!models/archive/
!models/.gitkeep
reports/

# Config with secrets — don't commit
config/settings.yaml
config/production.yaml
.env
.env.local

# Render
.render/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Database local files for dev (but allow data/trades.db for Block 2.1)
*.db
*.sqlite
!data/trades.db
!data/*.db

# Temporary files
tmp/
temp/

# IDE-specific
*.sublime-project
*.sublime-workspace

# OSX
.DS_Store

# Microsoft
Thumbs.db
