# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
*.log.*

# Data — sensitive, don't commit
data/
backups/
# P2-2: Runtime state — never commit. Historical files remain in git
# (cleaning history is too risky), but NEW state changes are forbidden.
models/*.jsonl
models/*.json
models/*.csv
models/*.pkl
models/*.bin
# Allow: samples (schemas), archive dir, .gitkeep
!models/samples/
!models/archive/
!models/.gitkeep
reports/

# Config with secrets — don't commit
config/settings.yaml           # если содержит реальные ключи
config/production.yaml         # если содержит реальные ключи
.env                          # реальные переменные окружения
.env.local

# Render
.render/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Database local files (если используете SQLite для dev)
*.db
*.sqlite

# Temporary files
tmp/
temp/

# IDE-specific
*.sublime-project
*.sublime-workspace

# OSX
.DS_Store

# Microsoft
Thumbs.db
.env
