name: Paper trade (hourly)

on:
  schedule:
    # Каждый час. Живая торговля внутри шага сама ограничена расписанием
    # (бюджет часов в месяц, активные сессии 08–24 МСК) через trading_schedule.
    - cron: "7 * * * *"
  workflow_dispatch:

concurrency:
  group: astra-paper
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  step:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          ref: master

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt python-dotenv

      - name: Restore prior paper state
        # Каждое почасовое исполнение стартует с чистого чекаута.
        # Состояние позиций/сделок живёт в git (paper_positions.json),
        # поэтому подтягиваем последние изменения мастера ПЕРЕД шагом.
        run: |
          git config user.name "astra-bot"
          git config user.email "bot@users.noreply.github.com"
          git pull --no-rebase origin master || true

      - name: Write .env
        env:
          OKX_API_KEY: ${{ secrets.OKX_API_KEY }}
          OKX_API_SECRET: ${{ secrets.OKX_API_SECRET }}
          OKX_API_PASSPHRASE: ${{ secrets.OKX_API_PASSPHRASE }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_ADMIN_ID: ${{ secrets.TELEGRAM_ADMIN_ID }}
        run: |
          {
            echo "ENVIRONMENT=paper"
            echo "PAPER_TRADING=true"
            echo "OKX_DEMO=1"
            echo "OKX_API_KEY=$OKX_API_KEY"
            echo "OKX_API_SECRET=$OKX_API_SECRET"
            echo "OKX_API_PASSPHRASE=$OKX_API_PASSPHRASE"
            echo "TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN"
            echo "TELEGRAM_ADMIN_ID=$TELEGRAM_ADMIN_ID"
          } > .env
          chmod 600 .env

      - name: One trading step (10 symbols, safety-gated)
        run: python scripts/run_paper.py --once

      - name: Commit state
        if: always()
        run: |
          git config user.name "astra-bot"
          git config user.email "bot@users.noreply.github.com"
          # Добавляем файлы по отдельности: отсутствие одного (нет закрытых
          # сделок -> нет .jsonl) не должно ронять весь add и терять позиции.
          for f in models/paper_positions.json models/paper_trades.jsonl \
                   models/live_lessons.jsonl models/trading_budget.json \
                   models/readiness.json models/training_state.json; do
            [ -f "$f" ] && git add -f "$f" || true
          done
          git diff --cached --quiet || \
            git commit -m "chore(ci): paper state $(date -u +%Y-%m-%dT%H:%MZ)"
          git push origin master || echo "push failed"
